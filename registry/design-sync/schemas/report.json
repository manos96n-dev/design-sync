{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "toolVersion": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "result": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "freshness": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "cache",
                "live"
              ]
            },
            "ageSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "source",
            "ageSeconds"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "const": "figma"
                  },
                  "fileKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "provider",
                  "fileKey",
                  "nodeId"
                ],
                "additionalProperties": false
              },
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "NOT_IMPLEMENTED",
                  "IMPLEMENTED",
                  "DESIGN_CHANGED",
                  "CODE_CHANGED",
                  "NEEDS_REVIEW",
                  "IGNORED"
                ]
              },
              "devStatus": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "READY_FOR_DEV",
                          "COMPLETED"
                        ]
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "route": {
                "type": "string"
              },
              "implementationFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "baselineDesignRevision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "currentDesignRevision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "baselineCodeRevision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "currentCodeRevision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "ADDED",
                        "REMOVED",
                        "MODIFIED"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "property": {
                      "type": "string"
                    },
                    "before": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "after": {
                      "$ref": "#/$defs/__schema1"
                    }
                  },
                  "required": [
                    "type",
                    "path",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "reference",
              "nodeId",
              "name",
              "status",
              "implementationFiles",
              "reasons",
              "changes"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "implemented": {
              "type": "number"
            },
            "designChanged": {
              "type": "number"
            },
            "notImplemented": {
              "type": "number"
            },
            "codeChanged": {
              "type": "number"
            },
            "needsReview": {
              "type": "number"
            },
            "ignored": {
              "type": "number"
            },
            "devStatus": {
              "type": "object",
              "properties": {
                "readyForDev": {
                  "type": "number"
                },
                "completed": {
                  "type": "number"
                },
                "none": {
                  "type": "number"
                },
                "unknown": {
                  "type": "number"
                }
              },
              "required": [
                "readyForDev",
                "completed",
                "none",
                "unknown"
              ],
              "additionalProperties": false
            },
            "coverage": {
              "type": "object",
              "properties": {
                "active": {
                  "type": "number"
                },
                "mappedToCode": {
                  "type": "number"
                },
                "mappedAwaitingBaseline": {
                  "type": "number"
                },
                "acceptedBaselines": {
                  "type": "number"
                },
                "unmapped": {
                  "type": "number"
                }
              },
              "required": [
                "active",
                "mappedToCode",
                "mappedAwaitingBaseline",
                "acceptedBaselines",
                "unmapped"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "implemented",
            "designChanged",
            "notImplemented",
            "codeChanged",
            "needsReview",
            "ignored",
            "devStatus",
            "coverage"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "observedAt",
        "freshness",
        "nodes",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "toolVersion",
    "command",
    "ok",
    "result"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
