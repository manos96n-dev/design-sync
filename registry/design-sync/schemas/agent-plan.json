{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "design-mapping"
    },
    "agentStarted": {
      "type": "boolean",
      "const": false
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "START_AGENT",
        "NO_ACTION"
      ]
    },
    "approval": {
      "type": "object",
      "properties": {
        "requiredBeforeAgentStart": {
          "type": "boolean"
        },
        "granted": {
          "type": "boolean",
          "const": false
        },
        "tokenUsageNotice": {
          "type": "boolean"
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "requiredBeforeAgentStart",
        "granted",
        "tokenUsageNotice",
        "question"
      ],
      "additionalProperties": false
    },
    "figmaCompletionApproval": {
      "type": "object",
      "properties": {
        "requiredBeforeWrite": {
          "type": "boolean",
          "const": true
        },
        "granted": {
          "type": "boolean",
          "const": false
        },
        "defaultAction": {
          "type": "string",
          "const": "LEAVE_FIGMA_UNCHANGED"
        },
        "cliCanWrite": {
          "type": "boolean",
          "const": false
        },
        "question": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      },
      "required": [
        "requiredBeforeWrite",
        "granted",
        "defaultAction",
        "cliCanWrite",
        "question",
        "instructions"
      ],
      "additionalProperties": false
    },
    "mappingCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "readiness": {
      "type": "object",
      "properties": {
        "readyForDev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "none": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "readyForDev",
        "completed",
        "none",
        "unknown"
      ],
      "additionalProperties": false
    },
    "mappingCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "figma"
              },
              "fileKey": {
                "type": "string",
                "minLength": 1
              },
              "nodeId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "fileKey",
              "nodeId"
            ],
            "additionalProperties": false
          },
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_IMPLEMENTED",
              "MAPPED_AWAITING_BASELINE",
              "IMPLEMENTED",
              "DESIGN_CHANGED",
              "CODE_CHANGED",
              "NEEDS_REVIEW",
              "IGNORED"
            ]
          },
          "devStatus": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "READY_FOR_DEV",
                      "COMPLETED"
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "route": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "reference",
          "nodeId",
          "name",
          "status",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "copyablePrompt": {
      "type": "string"
    },
    "promptAfterApproval": {
      "type": "string"
    },
    "observation": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "freshness": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "cache",
                "live"
              ]
            },
            "ageSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "source",
            "ageSeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "observedAt",
        "freshness"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "kind",
    "agentStarted",
    "recommendation",
    "approval",
    "figmaCompletionApproval",
    "mappingCandidateCount",
    "readiness",
    "mappingCandidates",
    "observation"
  ],
  "additionalProperties": false
}
